# CogniTrade 14-day soak template
# Copy to .env on the remote host and fill secrets.

# Binance
API_KEY=replace_with_testnet_api_key
API_SECRET=replace_with_testnet_api_secret
TESTNET=True
ENABLE_LIVE_TRADING=False

# Trading target
SYMBOL=BTCUSDT
TRADE_MODE=FUTURES
ENABLE_FUTURES_SHORTS=True

# Candidate profile (frozen during soak)
# Selected candidate: donchian_breakout (lookback_period=7, breakout_buffer_bps=10)
# Keep strategy/risk thresholds stable for the full soak window.

# Risk and sizing
MAX_ORDER_NOTIONAL_USD=100.0
MAX_POSITION_EXPOSURE_USD=250.0
MAX_SHORT_NOTIONAL_USD=100.0
DEFAULT_FUTURES_LEVERAGE=2.0
MAX_SHORT_LEVERAGE=3.0
MIN_SHORT_LIQUIDATION_BUFFER_PCT=20.0

# API security
API_AUTH_ENABLED=True
API_READ_KEYS=replace_with_read_key
API_ADMIN_KEYS=replace_with_admin_key
API_RATE_LIMIT_ENABLED=True
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60

# Rollout gates
ENABLE_ROLLOUT_GATES=True
ROLLOUT_STATE_STORE_PATH=data/rollout_gate_state.json
ROLLOUT_ENFORCE_PRODUCTION_GATE=True
ROLLOUT_REQUIRED_ID=don-7-10-soak-YYYYMMDD
ROLLOUT_REQUIRE_QUALITY_GATE=True
ROLLOUT_MIN_SHADOW_SAMPLES=50
ROLLOUT_MAX_SHADOW_ERROR_RATE=0.20
ROLLOUT_MIN_CANARY_SAMPLES=30
ROLLOUT_MAX_CANARY_ERROR_RATE=0.15
ROLLOUT_MAX_CANARY_DRAWDOWN_PCT=8.0
ROLLOUT_MIN_CANARY_RETURN_PCT=-1.0
ROLLOUT_MAX_CANARY_LATENCY_P95_MS=3000.0

# Quality gate
ENABLE_STRATEGY_QUALITY_GATE=True
QUALITY_MIN_WALK_FORWARD_FOLDS=3
QUALITY_MIN_SHARPE_RATIO=0.20
QUALITY_MIN_CALMAR_RATIO=0.10
QUALITY_MAX_DRAWDOWN_PCT=25.0
QUALITY_MIN_REGIME_SAMPLES=20
QUALITY_MIN_REGIME_WIN_RATE=0.45
QUALITY_MIN_REGIMES_PASSING=2

# Promotion benchmark
BENCHMARK_MIN_TOTAL_TRADES=25
BENCHMARK_MIN_NET_RETURN_PCT=1.0
BENCHMARK_MIN_SHARPE_RATIO=0.20
BENCHMARK_MIN_CALMAR_RATIO=0.10
BENCHMARK_MAX_DRAWDOWN_PCT=25.0
BENCHMARK_REQUIRE_QUALITY_GATE=True

# Reliability controls
ENABLE_RISK_ENGINE=True
ENABLE_OBSERVABILITY=True
ENABLE_RECONCILIATION=True
