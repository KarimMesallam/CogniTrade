[Unit]
Description=CogniTrade Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=karim
WorkingDirectory=/var/www/CogniTrade
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/var/www/CogniTrade/.env
ExecStart=/var/www/CogniTrade/venv/bin/python -m bot.main
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/CogniTrade
StandardOutput=append:/var/www/CogniTrade/logs/cognitrade-bot.service.log
StandardError=append:/var/www/CogniTrade/logs/cognitrade-bot.service.log

[Install]
WantedBy=multi-user.target
