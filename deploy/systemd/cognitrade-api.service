[Unit]
Description=CogniTrade API
After=network-online.target cognitrade-bot.service
Wants=network-online.target

[Service]
Type=simple
User=karim
WorkingDirectory=/var/www/CogniTrade/api
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/var/www/CogniTrade/.env
ExecStart=/var/www/CogniTrade/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/CogniTrade
StandardOutput=append:/var/www/CogniTrade/logs/cognitrade-api.service.log
StandardError=append:/var/www/CogniTrade/logs/cognitrade-api.service.log

[Install]
WantedBy=multi-user.target
