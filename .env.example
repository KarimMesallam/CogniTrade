# API Credentials
API_KEY=your_binance_testnet_api_key
API_SECRET=your_binance_testnet_api_secret

# Basic Configuration
TESTNET=True
ENABLE_LIVE_TRADING=False
SYMBOL=BTCUSDT

# Optional: Path to JSON configuration file (will override env vars if specified)
CONFIG_FILE=config.json

# Strategy Configuration
ENABLE_SIMPLE_STRATEGY=True
SIMPLE_STRATEGY_TIMEFRAME=1m
SIMPLE_STRATEGY_WEIGHT=1.0

ENABLE_TECHNICAL_STRATEGY=True
TECHNICAL_STRATEGY_TIMEFRAME=1h
TECHNICAL_STRATEGY_WEIGHT=2.0

# Technical Strategy Parameters
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
BB_PERIOD=20
BB_STD_DEV=2.0
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9

# Custom Strategy Configuration
ENABLE_CUSTOM_STRATEGY=False
CUSTOM_STRATEGY_TIMEFRAME=4h
CUSTOM_STRATEGY_WEIGHT=1.0
CUSTOM_STRATEGY_MODULE=bot.custom_strategies.my_strategy

# LLM Configuration
ENABLE_LLM_DECISIONS=True
LLM_REQUIRED_CONFIDENCE=0.6

# Primary LLM (DeepSeek latest reasoning alias)
LLM_PRIMARY_PROVIDER=deepseek
LLM_PRIMARY_MODEL=deepseek-reasoner
LLM_API_KEY=your_deepseek_api_key
LLM_API_ENDPOINT=https://api.deepseek.com/v1/chat/completions
LLM_TEMPERATURE=0.3

# Secondary LLM (OpenAI latest cost-effective tier)
LLM_SECONDARY_PROVIDER=openai
LLM_SECONDARY_MODEL=gpt-5-mini
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_TEMPERATURE=0.1

# Decision Making Configuration
CONSENSUS_METHOD=weighted_majority  # Options: simple_majority, weighted_majority, unanimous
MIN_STRATEGIES_FOR_DECISION=2
LLM_AGREEMENT_REQUIRED=True

# Trading Parameters
TRADE_MODE=SPOT
ENABLE_FUTURES_SHORTS=False
DEFAULT_ORDER_AMOUNT_USD=10.0
MAX_ORDER_AMOUNT_USD=100.0
MAX_ORDER_NOTIONAL_USD=100.0
MAX_POSITION_EXPOSURE_USD=250.0
MAX_SHORT_NOTIONAL_USD=100.0
DEFAULT_FUTURES_LEVERAGE=2.0
MAX_SHORT_LEVERAGE=3.0
MIN_SHORT_LIQUIDATION_BUFFER_PCT=20.0
RISK_PERCENTAGE=1.0
PROFIT_TARGET_PERCENTAGE=3.0
STOP_LOSS_PERCENTAGE=2.0
ENABLE_STOP_LOSS=True
ENABLE_TAKE_PROFIT=True

# Market Regime Detection (P1-08)
ENABLE_REGIME_DETECTION=True
REGIME_LOOKBACK_CANDLES=50
REGIME_TREND_THRESHOLD_PCT=0.02
REGIME_SIDEWAYS_THRESHOLD_PCT=0.01
REGIME_HIGH_VOLATILITY_THRESHOLD_PCT=0.015

# Regime Policy + Safe Switching (P1-09/P1-10)
ENABLE_REGIME_POLICY=True
POLICY_DEFAULT_REGIME=SIDEWAYS
POLICY_DEFAULT_SIZE_MULTIPLIER=1.0
POLICY_MIN_SWITCH_CONFIDENCE=0.55
POLICY_SWITCH_HYSTERESIS_CONFIRMATIONS=2
POLICY_SWITCH_COOLDOWN_SECONDS=900
POLICY_MAX_STRATEGY_TURNOVER_RATIO=1.0
POLICY_SWITCH_SHADOW_MODE=False
# Optional JSON override for per-regime policy mapping.
# Example:
# POLICY_REGIME_CONFIG_JSON={"BULL":{"size_multiplier":1.1},"BEAR":{"enabled_strategies":["technical"],"size_multiplier":0.7}}
POLICY_REGIME_CONFIG_JSON=

# Point-in-Time Data Pipeline (P2-01)
ENABLE_DATA_PIPELINE_PIT=True
PIT_REQUIRE_MONOTONIC_TIMESTAMPS=True
PIT_FEATURE_SOURCE=exchange_ohlcv

# Hard Live Risk Engine (P2-05)
ENABLE_RISK_ENGINE=True
RISK_ENGINE_MAX_DRAWDOWN_PCT=20.0
RISK_ENGINE_MAX_GROSS_EXPOSURE_USD=300.0
RISK_ENGINE_DAILY_LOSS_LIMIT_USD=100.0
RISK_ENGINE_KILL_SWITCH_ENABLED=True
RISK_ENGINE_ALLOW_RISK_REDUCING_ORDERS=True

# Exchange Reconciliation (P2-06)
ENABLE_RECONCILIATION=True
RECONCILIATION_RUN_ON_STARTUP=True
RECONCILIATION_INTERVAL_LOOPS=5
RECONCILIATION_POSITION_TOLERANCE=0.000001

# Observability Stack (P2-08)
ENABLE_OBSERVABILITY=True
OBS_MAX_EVENTS=4000
OBS_LATENCY_ALERT_MS=2500.0
OBS_ERROR_RATE_ALERT_THRESHOLD=0.25
OBS_ERROR_RATE_MIN_EVENTS=20
OBS_PERSISTENCE_ENABLED=True
# Supports SQLAlchemy URLs (sqlite/postgresql/mysql/etc.)
OBS_PERSISTENCE_DB_URL=sqlite:///data/observability.db

# Edge-Decay Monitoring (P2-07)
ENABLE_EDGE_MONITORING=True
EDGE_MONITOR_WINDOW_SIZE=50
EDGE_MONITOR_MIN_SAMPLES=20
EDGE_MONITOR_DERISK_HIT_RATE=0.45
EDGE_MONITOR_DISABLE_HIT_RATE=0.35
EDGE_MONITOR_DERISK_MEAN_RETURN=-0.0002
EDGE_MONITOR_DERISK_MULTIPLIER=0.5
EDGE_MONITOR_DISABLE_STICKY=True

# API Security Hardening
# Defaults to False on TESTNET=True and True when TESTNET=False.
# Keep enabled by default; disable only for isolated local testing.
API_AUTH_ENABLED=True
API_ALLOW_PUBLIC_HEALTH=True
# Comma-separated key lists.
API_READ_KEYS=
API_ADMIN_KEYS=
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
API_CORS_ALLOW_CREDENTIALS=False
API_CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
API_CORS_ALLOW_HEADERS=Authorization,Content-Type,X-API-Key,X-Request-ID
API_RATE_LIMIT_ENABLED=True
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60

# Rollout Gates (Shadow/Canary/Production)
ENABLE_ROLLOUT_GATES=True
ROLLOUT_STATE_STORE_PATH=data/rollout_gate_state.json
# Keep enabled for production-safety by default.
ROLLOUT_ENFORCE_PRODUCTION_GATE=True
# Required when production gate enforcement is enabled.
ROLLOUT_REQUIRED_ID=
ROLLOUT_MIN_SHADOW_SAMPLES=50
ROLLOUT_MAX_SHADOW_ERROR_RATE=0.20
ROLLOUT_MIN_CANARY_SAMPLES=30
ROLLOUT_MAX_CANARY_ERROR_RATE=0.15
ROLLOUT_MAX_CANARY_DRAWDOWN_PCT=8.0
ROLLOUT_MIN_CANARY_RETURN_PCT=-1.0
ROLLOUT_MAX_CANARY_LATENCY_P95_MS=3000.0
ROLLOUT_REQUIRE_QUALITY_GATE=True

# Strategy Quality Gate (promotion robustness checks)
ENABLE_STRATEGY_QUALITY_GATE=True
QUALITY_MIN_WALK_FORWARD_FOLDS=3
QUALITY_MIN_SHARPE_RATIO=0.20
QUALITY_MIN_CALMAR_RATIO=0.10
QUALITY_MAX_DRAWDOWN_PCT=25.0
QUALITY_MIN_REGIME_SAMPLES=20
QUALITY_MIN_REGIME_WIN_RATE=0.45
QUALITY_MIN_REGIMES_PASSING=2

# Timeframe Configuration
PRIMARY_TIMEFRAME=1m
SECONDARY_TIMEFRAME=1h
CANDLE_LIMIT=100

# Operational Settings
LOOP_INTERVAL_SECONDS=60
MAX_CONSECUTIVE_ERRORS=5
MAX_BACKOFF_SECONDS=3600
EXCHANGE_TIMEOUT_SECONDS=10
EXCHANGE_MAX_RETRIES=2
EXCHANGE_RETRY_BACKOFF_SECONDS=0.5
EXCHANGE_CIRCUIT_BREAKER_THRESHOLD=5
EXCHANGE_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.75
LLM_CIRCUIT_BREAKER_THRESHOLD=4
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=45
